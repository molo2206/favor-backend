<!doctype html>
<html lang="<%= lang || 'fr' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= translations.invoice %> | Favor Help
  </title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f7f4f0;
      padding: 12px;
      color: #1a1a1a;
    }

    .invoice-container {
      max-width: 900px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 4px;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
      border: 1px solid #e8e3dc;
      padding: 2rem 2.2rem;
    }

    /* HEADER - plus simple et épuré */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.8rem;
      padding-bottom: 1.2rem;
      border-bottom: 2px solid #f0ebe4;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .logo {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #0014D2;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 800;
      font-size: 1.2rem;
    }

    .logo img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .company-name {
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .company-tag {
      font-size: 0.65rem;
      color: #7a7a7a;
      font-weight: 400;
      margin-top: 2px;
    }

    .invoice-ref {
      text-align: right;
    }

    .invoice-ref .label {
      font-size: 0.6rem;
      text-transform: uppercase;
      color: #999;
      letter-spacing: 0.5px;
    }

    .invoice-ref .number {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0014D2;
    }

    /* Infos client */
    .client-section {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .client-block {}

    .client-block .label {
      font-size: 0.6rem;
      text-transform: uppercase;
      color: #999;
      letter-spacing: 0.3px;
    }

    .client-block .name {
      font-size: 1rem;
      font-weight: 700;
      margin-top: 3px;
    }

    .client-block .details {
      font-size: 0.78rem;
      color: #555;
      margin-top: 4px;
      line-height: 1.5;
    }

    .status-block {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      background: #f0ebe4;
      color: #555;
    }

    .status-block .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      display: inline-block;
    }

    .status-block.paid {
      background: #e6f3e6;
      color: #1a7a3a;
    }

    .status-block.paid .dot {
      background: #2e9e5a;
    }

    .status-block.pending {
      background: #fef3e2;
      color: #a8691e;
    }

    .status-block.pending .dot {
      background: #e8a838;
    }

    .status-block.rejected {
      background: #fce8e8;
      color: #b13e3e;
    }

    .status-block.rejected .dot {
      background: #d64a4a;
    }

    /* Grid infos */
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.8rem 2rem;
      background: #faf8f6;
      padding: 0.8rem 1.2rem;
      border-radius: 4px;
      margin-bottom: 1.5rem;
    }

    .info-grid .item {
      display: flex;
      gap: 6px;
      font-size: 0.75rem;
    }

    .info-grid .item strong {
      font-weight: 600;
      color: #333;
      min-width: 70px;
    }

    .info-grid .item span {
      color: #555;
    }

    /* Tableau - design épuré */
    .table-wrap {
      margin: 1.2rem 0 1.2rem 0;
      border: 1px solid #edebe8;
      border-radius: 4px;
      overflow: hidden;
    }

    table.items {
      width: 100%;
      border-collapse: collapse;
    }

    table.items th {
      background: #faf8f6;
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #777;
      font-weight: 600;
      padding: 0.6rem 0.8rem;
      text-align: left;
      border-bottom: 1px solid #e8e3dc;
    }

    table.items td {
      padding: 0.55rem 0.8rem;
      font-size: 0.78rem;
      border-bottom: 1px solid #f0ebe4;
      color: #222;
    }

    table.items tbody tr:last-child td {
      border-bottom: none;
    }

    table.items .text-right {
      text-align: right;
    }

    table.items .num {
      display: inline-block;
      width: 22px;
      height: 22px;
      background: #f0ebe4;
      border-radius: 50%;
      text-align: center;
      line-height: 22px;
      font-size: 0.6rem;
      font-weight: 600;
      color: #555;
    }

    .product-name {
      font-weight: 600;
    }

    /* Résumé - plus organique */
    .summary-area {
      display: flex;
      justify-content: flex-end;
      margin: 1rem 0 1.2rem 0;
    }

    .summary-box {
      width: 280px;
      border-top: 2px solid #f0ebe4;
      padding-top: 0.8rem;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      padding: 0.25rem 0;
      color: #444;
    }

    .summary-row.total {
      border-top: 2px solid #0014D2;
      margin-top: 0.4rem;
      padding-top: 0.6rem;
      font-weight: 700;
      font-size: 0.95rem;
      color: #0014D2;
    }

    .summary-row .label {
      color: #777;
    }

    /* Infos paiement - discrètes */
    .payment-info {
      background: #faf8f6;
      padding: 0.6rem 1rem;
      border-radius: 4px;
      margin: 0.6rem 0 1rem 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 2rem;
      font-size: 0.7rem;
      color: #555;
      border-left: 3px solid #0014D2;
    }

    .payment-info strong {
      color: #222;
      font-weight: 600;
    }

    /* Footer - simple et humain */
    .footer {
      border-top: 2px solid #f0ebe4;
      padding-top: 1rem;
      margin-top: 0.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.6rem;
      font-size: 0.7rem;
      color: #888;
    }

    .footer .thanks {
      font-weight: 500;
      color: #222;
    }

    .footer .meta {
      display: flex;
      gap: 1rem;
    }

    .footer .meta span {
      color: #aaa;
    }

    /* Responsive */
    @media (max-width: 700px) {
      .invoice-container {
        padding: 1.2rem;
      }

      .header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.6rem;
      }

      .invoice-ref {
        text-align: left;
        width: 100%;
      }

      .info-grid {
        grid-template-columns: 1fr;
        gap: 0.4rem;
        padding: 0.6rem 1rem;
      }

      .summary-area {
        justify-content: flex-start;
        width: 100%;
      }

      .summary-box {
        width: 100%;
      }

      .payment-info {
        flex-direction: column;
        gap: 0.3rem;
      }

      .footer {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media print {
      body {
        background: white;
        padding: 0;
      }

      .invoice-container {
        border: none;
        box-shadow: none;
        padding: 1.2rem;
      }

      .status-block {
        background: #f0ebe4 !important;
      }

      @page {
        margin: 0.8cm;
      }
    }
  </style>
</head>

<body>
  <div class="invoice-container">

    <!-- HEADER -->
    <div class="header">
      <div class="header-left">
        <div class="logo">
          <img src="https://api-prod.favorhelp.com/uploads/1%20Favor.webp" alt="Favor Help"
            onerror="this.onerror=null; this.textContent='FH';" />
        </div>
        <div>
          <div class="company-name">Favor Help</div>
          <div class="company-tag">
            <%= translations.invoice %>
          </div>
        </div>
      </div>
      <div class="invoice-ref">
        <div class="label">
          <%= translations.number %>
        </div>
        <div class="number">#<%= order ? order.invoiceNumber : 'INV-001' %>
        </div>
      </div>
    </div>

    <!-- CLIENT -->
    <div class="client-section">
      <div class="client-block">
        <div class="label">
          <%= translations.billed_to %>
        </div>
        <div class="name">
          <%= user ? user.fullName : 'Client' %>
        </div>
        <div class="details">
          <%= user ? user.email : 'client@email.com' %><br>
            <%= user ? user.phone : 'Non renseigné' %>
        </div>
      </div>
      <div>
        <% const status=(order && order.paymentStatus ? order.paymentStatus.trim().toUpperCase() : 'PENDING' ); %>
          <div class="status-block <%= status === 'PAID' ? 'paid' : status === 'REJECTED' ? 'rejected' : 'pending' %>">
            <span class="dot"></span>
            <%= status==='PAID' ? translations.status_paid : status==='REJECTED' ? translations.status_rejected :
              translations.status_pending %>
          </div>
          <div style="font-size:0.65rem; color:#999; margin-top:4px; text-align:right;">
            <%= translations.date %> : <%= new Date().toLocaleDateString('fr-FR') %>
          </div>
      </div>
    </div>

    <!-- INFOS SUPPLEMENTAIRES -->
    <div class="info-grid">
      <div class="item"><strong>
          <%= translations.address_label %> :
        </strong> <span>
          <%= order && order.address ? order.address : 'Adresse non renseignée' %>
        </span></div>
      <div class="item"><strong>
          <%= translations.reference %> :
        </strong> <span>#<%= order ? order.invoiceNumber : 'INV-001' %></span></div>
      <% if (typeof pinCode !=='undefined' && pinCode && pinCode !==null) { %>
        <div class="item"><strong>
            <%= translations.pin %> :
          </strong> <span style="font-weight:700; letter-spacing:1px; color:#0014D2;">
            <%= pinCode %>
          </span></div>
        <% } %>
    </div>

    <!-- TABLEAU -->
    <div class="table-wrap">
      <table class="items">
        <thead>
          <tr>
            <th style="width:40px;">#</th>
            <th>
              <%= translations.products %>
            </th>
            <th class="text-right" style="width:90px;">
              <%= translations.unit_price %>
            </th>
            <th class="text-right" style="width:50px;">
              <%= translations.qty %>
            </th>
            <th class="text-right" style="width:90px;">
              <%= translations.total %>
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (subOrders && subOrders.length) { var lineNumber=1; subOrders.forEach(function(subOrder) { if
            (subOrder.items && subOrder.items.length) { subOrder.items.forEach(function(item) { %>
            <tr>
              <td><span class="num">
                  <%= lineNumber++ %>
                </span></td>
              <td><span class="product-name">
                  <%= item.product ? item.product.name : 'Produit' %>
                </span></td>
              <td class="text-right">
                <%= order ? order.currency : 'USD' %>
                  <%= item.price || '0.00' %>
              </td>
              <td class="text-right">
                <%= item.quantity || '0' %>
              </td>
              <td class="text-right"><strong>
                  <%= order ? order.currency : 'USD' %>
                    <%= (item.price * item.quantity) || '0.00' %>
                </strong></td>
            </tr>
            <% }); } }); } else { %>
              <tr>
                <td colspan="5" style="text-align:center; padding:1.5rem; color:#999;">
                  <%= translations.no_items %>
                </td>
              </tr>
              <% } %>
        </tbody>
      </table>
    </div>

    <!-- PAIEMENT (si non payé) -->
    <% if (!(order && order.paymentStatus==='PAID' )) { %>
      <div class="payment-info">
        <span><strong>
            <%= translations.payment_info %>
          </strong></span>
        <span>
          <%= translations.account %> : 6882 0006 0761 632
        </span>
        <span>
          <%= translations.name %> : Kavira Naomi
        </span>
        <span>
          <%= translations.mobile_money %> : +243 962 646 653
        </span>
      </div>
      <% } %>

        <!-- RÉSUMÉ -->
        <div class="summary-area">
          <div class="summary-box">
            <div class="summary-row"><span class="label">
                <%= translations.subtotal %>
              </span> <span>
                <%= order ? order.currency : 'USD' %>
                  <%= order ? order.totalAmount : '0.00' %>
              </span></div>
            <div class="summary-row"><span class="label">
                <%= translations.delivery %>
              </span> <span>
                <%= order ? order.currency : 'USD' %>
                  <%= order && order.shippingCost ? order.shippingCost : '0.00' %>
              </span></div>
            <div class="summary-row total"><span>
                <%= translations.total_amount %>
              </span> <span>
                <%= order ? order.currency : 'USD' %>
                  <% var finalTotal=order ? (Number(order.totalAmount) + Number(order.shippingCost || 0)) : 0; %>
                    <%= finalTotal.toFixed(2) %>
              </span></div>
          </div>
        </div>

        <!-- FOOTER -->
        <div class="footer">
          <div class="thanks">
            <%= translations.thank_you %> — <%= translations.thanks_team %>
          </div>
          <div class="meta">
            <span>+243 991 225 122</span>
            <span>www.favorhelp.com</span>
            <span>RCCM: 21-A-770</span>
            <span>
              <%= new Date().getFullYear() %>
            </span>
          </div>
        </div>

  </div>
</body>

</html>